{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the deployed Worker, i.e. the host that serves the app:
  // https://minecraft-web.<subdomain>.workers.dev. Renaming this deploys a
  // second, empty Worker and leaves the live one stale.
  "name": "minecraft-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static assets = the built Vite SPA. The Worker only handles /api/*.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Working-state asset store (PNG textures, geometry, sounds) before a Save
  // flushes them into the project repo. Bound directly to the Worker so no R2
  // credential ever reaches the browser.
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "mmmmmmmmmmmmm-assets",
      "preview_bucket_name": "mmmmmmmmmmmmm-assets-preview"
    }
  ],

  "vars": {
    // Set a real value with:  npx wrangler secret put API_PASSPHRASE
    // When unset the Worker runs in open mode, which is fine for `wrangler dev`.
    "APP_NAME": "mmmmmmmmmmmmm"
  }
}
